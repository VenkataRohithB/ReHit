# Copy to .env for local or manual use:  cp .env.example .env
# .env is gitignored. Never commit real credentials.
#
# In CI these are NOT read from this file. The deploy workflow syncs them from
# the GitHub repository secrets ADMIN_USER / ADMIN_PASS into AWS SSM Parameter
# Store as SecureStrings, and the EC2 host reads them back with its instance
# role at deploy time. Change the value in GitHub secrets, not here.
ADMIN_USER=Admin
ADMIN_PASS=change-me
